@model List<Category>
<select class="form-select my-3" name="cat_id">
    <option hidden>select any category</option>

    @foreach(var cat in Model)
    {
        <option value="@cat.category_id" selected="@cat.category_id == ViewBag.categoryselectedId">@cat.category_name</option>
    }
   
</select>
