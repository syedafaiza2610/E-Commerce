@model Product


<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">Update Product</h2>
</div>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" value="@Model.product_id" name="product_id" />
            <input type="text" value="@Model.product_name" name="product_name" class="form-control my-3" />
            <input type="text" value="@Model.product_price" name="product_price" class="form-control my-3" />
            <input type="text" value="@Model.product_description" name="product_description" class="form-control my-3" />
            @* replace by cat_id *@
            @Html.Partial("CategoryDropdown", ViewData["category"]) 
            <input type="hidden" value="@Model.product_image" name="product_image" />
            <input type="submit" value="Update Profile" class="form-control my-3 btn btn-primary" />
        </form>
        <form method="post" asp-action="ChangeProductImage" enctype="multipart/form-data">
            <input type="hidden" name="product_id" value="@Model.product_id" />
            <input type="hidden" name="product_name" value="@Model.product_name" />
            <input type="hidden" name="product_description" value="@Model.product_description" />
            <input type="hidden" name="product_price" value="@Model.product_price" />
            <input type="hidden" value="@Model.cat_id" name="cat_id" class="form-control my-3" />
            <input type="file"
                   name="product_image"
                   class="form-control my-3"
                   style="padding:8px; border:2px dashed #457b9d; background:#f8f9fa;" />

            <img src="~/Product_images/@Model.product_image"
                 asp-append-version="true"
                 style="width:150px; height:150px; border-radius:50%; object-fit:cover;
            display:block; margin:15px auto; border:3px solid #1d3557;" />

            <input type="submit"
                   value="Update Product"
                   style="background:#1d3557; color:white; padding:10px 20px;
              border:none; border-radius:6px; width:100%; cursor:pointer;" />

        </form>

    </div>
    <div class="col-md-2"></div>
</div>