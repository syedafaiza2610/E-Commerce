@model List<Customer>

<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">
        All Customer
    </h2>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped mt-3 text-center">
                <thead>
                    <tr>
                        <th>Customer Name</th>
                        @* <th>Customer Phone</th> *@
                        <th>Customer Country</th>
                        <th>Customer City</th>
                        <th>Customer Email</th>
                        @* <th>Customer Password</th>
                        <th>Customer Address</th> *@
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cust in Model)
                    {
                        <tr>
                            <td>@cust.customer_name</td>
                            @* <td>@cust.customer_phone</td> *@
                            <td>@cust.customer_country</td>
                            <td>@cust.customer_city</td>
                            <td>@cust.customer_email</td>
                            @* <td>@cust.customer_password</td>
                            <td>@cust.customer_address</td> *@
                            <td>
                                <a asp-controller="Admin" asp-action="CustomerDetails" asp-route-id="@cust.customer_id" class="btn btn-primary">
                                    Details</a>


                                <a asp-controller="Admin" asp-action="UpdateCustomer" asp-route-id="@cust.customer_id" class="btn btn-warning">
                                    Update
                                </a>


                                <a asp-controller="Admin" asp-action="DeletePermission" asp-route-id="@cust.customer_id" class="btn btn-danger">
                                    Delete
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
