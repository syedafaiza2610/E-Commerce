@model List<Cart>

<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">
        All Cart Items
    </h2>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped mt-3 text-center">
                <thead>
                    <tr>

                        <th>Cart ID</th>
                        <th>Product Name</th>
                        <th>Customer Name</th>
                        <th>Product Quantity</th>
                        <th>Cart Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cart in Model)
                    {
                        <tr>
                            <td>@cart.cart_id</td>
                            <td>@cart.products.product_name</td>
                            <td>@cart.customers.customer_name</td>
                            <td>@cart.product_quantity</td>
                            <td>@cart.cart_status</td>
                          

                            <td>
                          
                                <a asp-controller="Admin" asp-action="UpdateCart"
                                   asp-route-id="@cart.cart_id" class="btn btn-warning">
                                   Update
                                </a>
                                <a asp-controller="Admin" asp-action="DeletePermissionCart"
                                   asp-route-id="@cart.cart_id" class="btn btn-danger">
                                    Delete
                                </a>

                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>




