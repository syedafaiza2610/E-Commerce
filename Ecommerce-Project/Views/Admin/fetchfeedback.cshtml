@model List<Feedback>

<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">
        All Feedbacks
    </h2>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered table-striped mt-3 text-center">
                <thead>
                    <tr>
                       
                        <th>User Id</th>
                        <th>User Name</th>
                        <th>User Message</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feed in Model)
                    {
                        <tr>
                            <td>@feed.feedback_id</td>
                            <td>@feed.user_name</td>
                            <td>@feed.user_message</td>
                          
                            <td>
                                <a asp-controller="Admin" asp-action="DeletePermissionfeedback" 
                                asp-route-id="@feed.feedback_id" class="btn btn-danger">
                                    Delete
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


